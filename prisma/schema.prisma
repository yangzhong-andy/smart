model TikTokProduct {
  id          String    @id @default(uuid())
  shopId      String // 店铺ID
  productId   String    @unique // TikTok 产品ID
  title       String? // 产品标题
  description String? // 产品描述
  status      String? // 产品状态
  categoryId  String? // 分类ID
  mainImage   String? // 主图URL
  images      String[] // 图片列表
  url         String? // 产品链接
  createTime  DateTime? // 创建时间
  rawData     Json? // 原始数据
  syncedAt    DateTime  @default(now()) // 同步时间

  @@index([shopId])
  @@index([productId])
  @@index([status])
}

// TikTok Webhook 事件日志
model TikTokWebhookLog {
  id             String    @id @default(uuid())
  shopId         String? // 店铺ID
  eventType      String? // 事件类型 (ORDER_STATUS_CHANGE 等)
  notificationId String? // TikTok 通知ID
  eventTypeNum   Int? // 数字类型
  timestamp      DateTime? // 事件时间
  rawData        Json // 完整原始数据
  signatureValid Boolean   @default(false) // 签名是否验证通过
  processed      Boolean   @default(false) // 是否已处理
  processError   String? // 处理错误信息
  createdAt      DateTime  @default(now()) // 接收时间

  @@index([shopId])
  @@index([eventType])
  @@index([notificationId])
  @@index([createdAt])
}

// TikTok App 配置（支持多个 Private App）
model TikTokAppConfig {
  id        String   @id @default(uuid())
  appKey    String   @unique // TikTok App Key
  appSecret String // TikTok App Secret
  appName   String? // 应用名称（备注）
  remark    String? // 备注（如：BRILHO NOVO 店铺专用）
  status    String   @default("active") // active/disabled
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appKey])
  @@index([status])
}

// TikTok 仓库映射（TikTok warehouse_id → 系统仓库）
model TikTokWarehouseMapping {
  id                String   @id @default(uuid())
  tiktokWarehouseId String   @unique // TikTok 的 warehouse_id
  tiktokShopId      String? // 关联的店铺ID（可选，不同店铺可能不同仓库）
  warehouseId       String // 系统的 Warehouse.id
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tiktokShopId])
}

// Effective-dated fulfillment-provider routing used by profit reports. Each
// row is a new switch point, so providers can be selected repeatedly without
// overwriting the warehouse assigned to earlier orders.
model ProfitWarehouseSwitchRule {
  id                  String    @id @default(uuid())
  platform            String    @default("TIKTOK")
  region              String
  shopId              String
  externalWarehouseId String
  warehouseId         String
  effectiveFrom       DateTime
  effectiveOrderId    String?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  warehouse           Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([platform, shopId, externalWarehouseId, effectiveFrom])
  @@index([platform, region, shopId, externalWarehouseId, effectiveFrom])
  @@index([warehouseId, effectiveFrom])
}

// TikTok SKU 映射（TikTok seller_sku → 系统 variant）
model TikTokSkuMapping {
  id              String   @id @default(uuid())
  tiktokShopId    String // TikTok 店铺ID
  tiktokProductId String? // TikTok 产品ID
  tiktokSkuId     String? // TikTok SKU ID
  tiktokSkuName   String? // TikTok SKU 名称
  sellerSku       String // TikTok seller_sku（订单里的）
  variantId       String // 系统的 Variant.id
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tiktokShopId, sellerSku])
  @@index([tiktokShopId])
  @@index([sellerSku])
}

// TikTok 订单库存扣减记录
// Platform seller SKU cost mapping used by profit reports. A seller SKU can
// contain multiple internal variants, which keeps bundle costing accurate.
model ProfitSkuMapping {
  id         String                      @id @default(uuid())
  platform   String                      @default("TIKTOK")
  shopId     String
  sellerSku  String
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt
  components ProfitSkuMappingComponent[]

  @@unique([platform, shopId, sellerSku])
  @@index([shopId])
  @@index([sellerSku])
}

model ProfitSkuMappingComponent {
  id        String           @id @default(uuid())
  mappingId String
  variantId String
  quantity  Int              @default(1)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  mapping   ProfitSkuMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)
  variant   ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([mappingId, variantId])
  @@index([variantId])
}

// Effective-dated percentage and fallback rules used by store profit reports.
model ProfitShopCostRule {
  id               String                  @id @default(uuid())
  platform         String                  @default("TIKTOK")
  shopId           String
  costType         String
  ratePercent      Decimal                 @default(0) @db.Decimal(10, 6)
  fixedPerOrder    Decimal                 @default(0) @db.Decimal(18, 4)
  fixedPerUnit     Decimal                 @default(0) @db.Decimal(18, 4)
  currency         String                  @default("BRL")
  effectiveFrom    DateTime                @db.Date
  effectiveTo      DateTime?               @db.Date
  enabled          Boolean                 @default(true)
  notes            String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  platformFeeTiers ProfitPlatformFeeTier[]

  @@unique([platform, shopId, costType, effectiveFrom])
  @@index([shopId, costType, effectiveFrom])
}

model ProfitPlatformFeeTier {
  id                  String             @id @default(uuid())
  ruleId              String
  minOrderAmount      Decimal?           @db.Decimal(18, 4)
  maxOrderAmount      Decimal?           @db.Decimal(18, 4)
  minInclusive        Boolean            @default(true)
  maxInclusive        Boolean            @default(false)
  platformRatePercent Decimal            @default(0) @db.Decimal(10, 6)
  perUnitFee          Decimal            @default(0) @db.Decimal(18, 4)
  currency            String             @default("BRL")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  rule                ProfitShopCostRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

// Overseas warehouse fulfillment pricing. The order warehouse_id decides
// which rule applies, so shops can switch warehouses without rewriting history.
model WarehouseFulfillmentRule {
  id                    String                        @id @default(uuid())
  warehouseId           String
  shopId                String?
  pricingMode           String                        @default("FLAT_UNIT")
  billingUnit           String                        @default("SELLER_UNIT")
  baseOrderFee          Decimal                       @default(0) @db.Decimal(18, 4)
  firstUnitFee          Decimal                       @default(0) @db.Decimal(18, 4)
  additionalUnitFee     Decimal                       @default(0) @db.Decimal(18, 4)
  volumetricDivisor     Int                           @default(6000)
  overweightThresholdKg Decimal?                      @db.Decimal(10, 3)
  overweightFeePerKg    Decimal                       @default(0) @db.Decimal(18, 4)
  currency              String                        @default("BRL")
  effectiveFrom         DateTime                      @db.Date
  effectiveTo           DateTime?                     @db.Date
  enabled               Boolean                       @default(true)
  notes                 String?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  warehouse             Warehouse                     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  feeTiers              WarehouseFulfillmentFeeTier[]

  @@index([warehouseId, effectiveFrom])
  @@index([shopId, effectiveFrom])
}

model WarehouseFulfillmentFeeTier {
  id              String                   @id @default(uuid())
  ruleId          String
  minWeightKg     Decimal?                 @db.Decimal(10, 3)
  maxWeightKg     Decimal?                 @db.Decimal(10, 3)
  minInclusive    Boolean                  @default(false)
  maxInclusive    Boolean                  @default(true)
  maxLengthCm     Decimal?                 @db.Decimal(10, 2)
  maxWidthCm      Decimal?                 @db.Decimal(10, 2)
  maxHeightCm     Decimal?                 @db.Decimal(10, 2)
  baseFee         Decimal                  @default(0) @db.Decimal(18, 4)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  fulfillmentRule WarehouseFulfillmentRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

// Per-order financial snapshot from TikTok statement transactions. Settled
// snapshots replace estimates while preserving the order-level calculation.
model TikTokOrderFinancial {
  id                      String    @id @default(uuid())
  orderId                 String    @unique
  shopId                  String
  orderCreateTime         DateTime?
  currency                String    @default("BRL")
  revenueAmount           Decimal   @default(0) @db.Decimal(18, 4)
  feeTaxAmount            Decimal   @default(0) @db.Decimal(18, 4)
  referralFeeAmount       Decimal   @default(0) @db.Decimal(18, 4)
  smartPromotionFeeAmount Decimal   @default(0) @db.Decimal(18, 4)
  shippingCostAmount      Decimal   @default(0) @db.Decimal(18, 4)
  actualShippingFeeAmount Decimal   @default(0) @db.Decimal(18, 4)
  fbtFulfillmentFeeAmount Decimal   @default(0) @db.Decimal(18, 4)
  adjustmentAmount        Decimal   @default(0) @db.Decimal(18, 4)
  settlementAmount        Decimal   @default(0) @db.Decimal(18, 4)
  transactionCount        Int       @default(0)
  source                  String    @default("ESTIMATED")
  statementIds            String[]  @default([])
  syncedAt                DateTime  @default(now())
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([shopId, orderCreateTime])
  @@index([source, syncedAt])
}

// Auditable platform settlement rows. Platform adapters preserve the raw
// payload here, then rebuild the order-level financial snapshot above.
model PlatformSettlementTransaction {
  id                      String    @id @default(uuid())
  platform                String
  externalShopId          String
  externalStatementId     String
  externalTransactionId   String
  orderId                 String
  orderCreateTime         DateTime?
  transactionType         String?
  currency                String
  revenueAmount           Decimal   @default(0) @db.Decimal(18, 4)
  feeTaxAmount            Decimal   @default(0) @db.Decimal(18, 4)
  referralFeeAmount       Decimal   @default(0) @db.Decimal(18, 4)
  smartPromotionFeeAmount Decimal   @default(0) @db.Decimal(18, 4)
  shippingCostAmount      Decimal   @default(0) @db.Decimal(18, 4)
  actualShippingFeeAmount Decimal   @default(0) @db.Decimal(18, 4)
  fbtFulfillmentFeeAmount Decimal   @default(0) @db.Decimal(18, 4)
  adjustmentAmount        Decimal   @default(0) @db.Decimal(18, 4)
  settlementAmount        Decimal   @default(0) @db.Decimal(18, 4)
  rawData                 Json
  syncedAt                DateTime  @default(now())
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([platform, externalShopId, externalTransactionId])
  @@index([platform, externalShopId, externalStatementId])
  @@index([platform, externalShopId, orderId])
  @@index([orderCreateTime])
}

// One checkpoint per platform statement makes a large historical backfill
// resumable without duplicating transactions or skipping empty statements.
model PlatformSettlementSyncState {
  id                  String    @id @default(uuid())
  platform            String
  externalShopId      String
  externalStatementId String
  status              String    @default("PENDING")
  expectedCount       Int?
  syncedCount         Int       @default(0)
  attemptCount        Int       @default(0)
  lastError           String?
  startedAt           DateTime?
  completedAt         DateTime?
  lastSyncedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([platform, externalShopId, externalStatementId])
  @@index([platform, externalShopId, status])
  @@index([lastSyncedAt])
}

// Optional attribution and manually entered costs for TikTok sample orders.
// Product and fulfillment costs remain derived from the order itself.
model InfluencerSampleCost {
  id                 String      @id @default(uuid())
  orderId            String      @unique
  shopId             String
  influencerId       String?
  teamName           String?
  manualShippingCost Decimal     @default(0) @db.Decimal(18, 4)
  otherCost          Decimal     @default(0) @db.Decimal(18, 4)
  currency           String      @default("BRL")
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  influencer         Influencer? @relation(fields: [influencerId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([influencerId])
}

// Versioned profit configuration for one internal store. Country and platform
// are snapshots so historical calculations never inherit later store changes.
model ProfitScheme {
  id             String                  @id @default(uuid())
  storeId        String
  externalShopId String?
  name           String
  platform       String
  countryCode    String
  currency       String
  timeZone       String
  version        Int
  status         String                  @default("DRAFT")
  effectiveFrom  DateTime                @db.Date
  effectiveTo    DateTime?               @db.Date
  notes          String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  store          Store                   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  components     ProfitSchemeComponent[]
  orderLedgers   ProfitOrderLedger[]

  @@unique([storeId, version])
  @@index([platform, countryCode, status])
  @@index([storeId, status, effectiveFrom])
  @@index([externalShopId, effectiveFrom])
}

// A scheme owns its display fields and calculation sources. Labels can be
// country-specific while category keeps cross-country reporting comparable.
model ProfitSchemeComponent {
  id              String                   @id @default(uuid())
  schemeId        String
  code            String
  label           String
  category        String
  direction       String
  calculationMode String                   @default("SOURCE")
  sourceKey       String?
  includeInGmv    Boolean                  @default(false)
  includeInProfit Boolean                  @default(true)
  required        Boolean                  @default(true)
  visible         Boolean                  @default(true)
  sortOrder       Int                      @default(0)
  config          Json?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  scheme          ProfitScheme             @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  ledgerEntries   ProfitOrderLedgerEntry[]

  @@unique([schemeId, code])
  @@index([schemeId, sortOrder])
  @@index([category])
}

// Immutable calculation revisions for an order. Recalculation creates a new
// revision and marks the previous one non-current instead of overwriting it.
model ProfitOrderLedger {
  id                 String                   @id @default(uuid())
  platform           String
  externalShopId     String
  storeId            String
  orderId            String
  businessDate       DateTime                 @db.Date
  orderCurrency      String
  exchangeRateCny    Decimal                  @db.Decimal(18, 8)
  schemeId           String?
  schemeVersion      Int
  calculationVersion Int                      @default(1)
  isCurrent          Boolean                  @default(true)
  calculationStatus  String                   @default("CALCULATED")
  inputHash          String?
  calculatedAt       DateTime                 @default(now())
  createdAt          DateTime                 @default(now())
  store              Store                    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  scheme             ProfitScheme?            @relation(fields: [schemeId], references: [id], onDelete: SetNull)
  entries            ProfitOrderLedgerEntry[]

  @@unique([platform, externalShopId, orderId, calculationVersion])
  @@index([storeId, businessDate, isCurrent])
  @@index([externalShopId, businessDate, isCurrent])
  @@index([calculationStatus, calculatedAt])
}

model ProfitOrderLedgerEntry {
  id                String                 @id @default(uuid())
  ledgerId          String
  schemeComponentId String?
  componentCode     String
  label             String
  category          String
  direction         String
  amountOriginal    Decimal?               @db.Decimal(18, 4)
  currency          String?
  originalAmounts   Json
  amountCny         Decimal                @db.Decimal(18, 4)
  sourceStatus      String
  includeInGmv      Boolean                @default(false)
  includeInProfit   Boolean                @default(true)
  metadata          Json?
  createdAt         DateTime               @default(now())
  ledger            ProfitOrderLedger      @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  schemeComponent   ProfitSchemeComponent? @relation(fields: [schemeComponentId], references: [id], onDelete: SetNull)

  @@unique([ledgerId, componentCode])
  @@index([componentCode, category])
  @@index([schemeComponentId])
}

model TikTokStockDeduction {
  id            String   @id @default(uuid())
  tiktokOrderId String // TikTok 订单号
  shopId        String // 店铺ID
  warehouseId   String // 扣减的系统仓库ID
  variantId     String // 系统产品变体ID
  sellerSku     String? // TikTok SKU
  qty           Int // 扣减数量
  status        String   @default("deducted") // deducted / reverted
  createdAt     DateTime @default(now())

  @@unique([tiktokOrderId, variantId])
  @@index([tiktokOrderId])
  @@index([shopId])
}

// TikTok 渠道号配置（标记哪些账号是店铺渠道号）
model TikTokChannel {
  id        String   @id @default(uuid())
  shopId    String // 关联的店铺ID
  username  String // TikTok 用户名（不含@）
  remark    String? // 备注
  createdAt DateTime @default(now())

  @@unique([shopId, username])
  @@index([shopId])
}
