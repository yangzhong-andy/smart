generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Supplier {
  id                 String              @id @default(uuid())
  name               String
  contact            String
  phone              String
  depositRate        Decimal             @db.Decimal(5, 2)
  tailPeriodDays     Int
  settleBase         SettleBase
  level              SupplierLevel?
  category           String?
  address            String?
  bankAccount        String?
  bankName           String?
  taxId              String?
  invoiceRequirement InvoiceRequirement?
  invoicePoint       Decimal?            @db.Decimal(5, 2)
  defaultLeadTime    Int?
  moq                Int?
  factoryImages      Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  defaultProducts    Product[]           @relation("DefaultSupplier")
  productSuppliers   ProductSupplier[]
  contracts          PurchaseContract[]  @relation("SupplierToContract")
}

model Product {
  id                String            @id @default(uuid())
  spuCode           String?
  name              String
  category          String?
  brand             String?
  description       String?
  mainImage         String?
  galleryImages     Json?
  material          String?
  specDescription   String?
  status            ProductStatus     @default(ACTIVE)
  suppliers         Json?
  customsNameCN     String?
  customsNameEN     String?
  defaultSupplierId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  defaultSupplier   Supplier?         @relation("DefaultSupplier", fields: [defaultSupplierId], references: [id])
  productSuppliers  ProductSupplier[]
  variants          ProductVariant[]
  videoTasks        VideoTask[]

  @@index([defaultSupplierId])
}

model ProductVariant {
  id                  String                      @id @default(uuid())
  productId           String
  skuId               String                      @unique
  color               String?
  size                String?
  weightKg            Decimal?                    @db.Decimal(10, 3)
  barcode             String?
  costPrice           Decimal?                    @db.Decimal(18, 2)
  stockQuantity       Int                         @default(0)
  currency            String                      @default("CNY")
  targetRoi           Decimal?                    @db.Decimal(5, 2)
  lengthCm            Decimal?                    @db.Decimal(10, 2)
  widthCm             Decimal?                    @db.Decimal(10, 2)
  heightCm            Decimal?                    @db.Decimal(10, 2)
  volumetricDivisor   Int?
  atFactory           Int                         @default(0)
  atDomestic          Int                         @default(0)
  inTransit           Int                         @default(0)
  platformSkuMapping  Json?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  inventoryLogs       InventoryLog[]
  movements           InventoryMovement[]
  ownershipLedgers    InventoryOwnershipLedger[]
  inventories         InventoryStock[]
  outboundBatchItems  OutboundBatchItem[]
  outboundOrders      OutboundOrder[]
  outboundOrderItems  OutboundOrderItem[]
  pendingInbound      PendingInbound[]
  pendingInboundItems PendingInboundItem[]
  product             Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  profitCalculations  ProfitCalculation[]
  profitSkuComponents ProfitSkuMappingComponent[]
  contractItems       PurchaseContractItem[]
  stocks              Stock[]
  stockLogs           StockLog[]

  @@index([productId])
  @@index([skuId])
}

model Store {
  id                  String              @id @default(uuid())
  name                String
  platform            Platform
  country             String
  currency            String
  accountId           String
  accountName         String
  vatNumber           String?
  taxId               String?
  createdAt           DateTime            @default(now())
  overseasCompanyId   String?
  overseasCompanyName String?
  bankAccounts        BankAccount[]
  inventoryStocks     InventoryStock[]
  logistics           LogisticsTracking[]
  purchaseOrders      PurchaseOrder[]
  profitSchemes       ProfitScheme[]
  profitOrderLedgers  ProfitOrderLedger[]
  tiktokShopSetting   TikTokShopSetting?
}

model Influencer {
  id                       String                 @id @default(uuid())
  accountName              String
  platform                 Platform
  accountUrl               String?
  followerCount            Int
  contactInfo              String
  category                 String
  cooperationStatus        String
  sampleStatus             String
  sampleOrderNumber        String?
  sampleTrackingNumber     String?
  sampleProductSku         String?
  sampleProductId          String?
  sampleSentAt             DateTime?
  sampleReceivedAt         DateTime?
  historicalEngagementRate Decimal?               @db.Decimal(5, 2)
  estimatedOrders          Int?
  actualOrders             Int?
  notes                    String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  videoTasks               VideoTask[]
  sampleCostAttributions   InfluencerSampleCost[]
}

model Department {
  id              String                @id @default(uuid())
  name            String                @unique
  code            String?               @unique
  description     String?
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  commissionRules CommissionRule[]
  accessRule      DepartmentAccessRule?
  employees       Employee[]
  purchaseOrders  PurchaseOrder[]
  users           User[]

  @@index([code])
  @@index([name])
}

model DepartmentAccessRule {
  id           String     @id @default(uuid())
  departmentId String     @unique
  config       Json
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  password     String
  name         String
  role         String      @default("USER")
  departmentId String?
  isActive     Boolean     @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  department   Department? @relation(fields: [departmentId], references: [id])

  @@index([email])
  @@index([departmentId])
}

model Employee {
  id                     String             @id @default(uuid())
  name                   String
  employeeNumber         String?
  department             String
  departmentId           String?
  position               String
  joinDate               DateTime
  phone                  String?
  email                  String?
  status                 EmploymentStatus   @default(ACTIVE)
  responsibleInfluencers String[]
  responsibleSuppliers   String[]
  responsibleStores      String[]
  notes                  String?
  // 薪资档案字段
  bankAccount            String?
  bankName               String?
  idNumber               String?
  baseSalary             Float?             @default(2200)
  positionSalary         Float?             @default(0)
  fullAttendanceBonus    Float?             @default(200)
  pensionInsurance       Float?             @default(323.44)
  unemploymentInsurance  Float?             @default(20.22)
  medicalInsurance       Float?             @default(88.66)
  leaveDate              DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  commissionRecords      CommissionRecord[]
  departmentRelation     Department?        @relation(fields: [departmentId], references: [id])
  videoTasks             VideoTask[]        @relation("Assignee")

  @@index([departmentId])
}

model CommissionRule {
  id                 String             @id @default(uuid())
  name               String
  department         DepartmentEnum
  departmentId       String?
  position           String?
  type               CommissionRuleType
  config             Json
  dataSource         Json
  period             CommissionPeriod
  startDate          DateTime?
  endDate            DateTime?
  enabled            Boolean            @default(true)
  description        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  records            CommissionRecord[]
  departmentRelation Department?        @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
}

model CommissionRecord {
  id          String         @id @default(uuid())
  employeeId  String
  ruleId      String
  periodLabel String
  amount      Decimal        @db.Decimal(18, 2)
  currency    String         @default("CNY")
  details     Json?
  generatedAt DateTime       @default(now())
  employee    Employee       @relation(fields: [employeeId], references: [id])
  rule        CommissionRule @relation(fields: [ruleId], references: [id])
}

model Warehouse {
  id                String                      @id @default(uuid())
  code              String                      @unique
  name              String
  address           String?
  contact           String?
  phone             String?
  manager           String?
  location          InventoryLocation
  type              WarehouseType               @default(DOMESTIC)
  isActive          Boolean                     @default(true)
  capacity          Int?
  balance           Decimal?                    @default(0) @db.Decimal(18, 2) // 海外仓一件代发费用余额
  notes             String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  inboundBatches    InboundBatch[]
  inventoryLogsFrom InventoryLog[]              @relation("InventoryLogFrom")
  inventoryLogsTo   InventoryLog[]              @relation("InventoryLogTo")
  inventoryLogs     InventoryLog[]              @relation("InventoryLogWarehouse")
  outboundBatches   OutboundBatch[]
  outboundOrders    OutboundOrder[]
  stocks            Stock[]
  stockLogs         StockLog[]
  profitFeeRules    WarehouseFulfillmentRule[]
  profitSwitchRules ProfitWarehouseSwitchRule[]

  @@index([code])
  @@index([location])
  @@index([type])
}

model Stock {
  id           String         @id @default(uuid())
  variantId    String
  warehouseId  String
  qty          Int            @default(0)
  reservedQty  Int            @default(0)
  availableQty Int            @default(0)
  updatedAt    DateTime       @updatedAt
  createdAt    DateTime       @default(now())
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([variantId, warehouseId])
  @@index([variantId])
  @@index([warehouseId])
}

model InventoryStock {
  id        String            @id @default(uuid())
  variantId String
  storeId   String?
  location  InventoryLocation
  qty       Int               @default(0)
  updatedAt DateTime          @updatedAt
  createdAt DateTime          @default(now())
  store     Store?            @relation(fields: [storeId], references: [id])
  variant   ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, location, storeId])
  @@index([variantId])
}

model StockLog {
  id                 String                @id @default(uuid())
  variantId          String
  warehouseId        String
  reason             StockLogReason
  movementType       InventoryMovementType
  qty                Int
  qtyBefore          Int
  qtyAfter           Int
  unitCost           Decimal?              @db.Decimal(18, 2)
  totalCost          Decimal?              @db.Decimal(18, 2)
  currency           String?
  operator           String?
  operationDate      DateTime
  relatedOrderId     String?
  relatedOrderType   String?
  relatedOrderNumber String?
  notes              String?
  createdAt          DateTime              @default(now())
  variant            ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse          Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([warehouseId])
  @@index([reason])
  @@index([operationDate])
}

model InventoryLog {
  id              String             @id @default(uuid())
  type            InventoryLogType
  status          InventoryLogStatus
  variantId       String
  qty             Int
  warehouseId     String?
  fromWarehouseId String?
  toWarehouseId   String?
  deliveryOrderId String?
  relatedOrderNo  String?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deliveryOrder   DeliveryOrder?     @relation(fields: [deliveryOrderId], references: [id])
  fromWarehouse   Warehouse?         @relation("InventoryLogFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse?         @relation("InventoryLogTo", fields: [toWarehouseId], references: [id])
  variant         ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse       Warehouse?         @relation("InventoryLogWarehouse", fields: [warehouseId], references: [id])

  @@index([variantId])
  @@index([warehouseId])
  @@index([deliveryOrderId])
  @@index([type])
  @@index([status])
}

model InventoryMovement {
  id                 String                @id @default(uuid())
  variantId          String
  location           InventoryLocation
  movementType       InventoryMovementType
  qty                Int
  qtyBefore          Int
  qtyAfter           Int
  unitCost           Decimal?              @db.Decimal(18, 2)
  totalCost          Decimal?              @db.Decimal(18, 2)
  currency           String?
  relatedOrderId     String?
  relatedOrderType   String?
  relatedOrderNumber String?
  operator           String?
  operationDate      DateTime
  notes              String?
  createdAt          DateTime              @default(now())
  variant            ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
}

model LogisticsChannel {
  id             String              @id @default(uuid())
  name           String
  channelCode    String
  contact        String
  phone          String
  queryUrl       String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  logisticsCosts LogisticsCost[]
  trackings      LogisticsTracking[]
}

model LogisticsTracking {
  id                  String           @id @default(uuid())
  internalOrderNumber String
  trackingNumber      String           @unique
  channelId           String
  storeId             String?
  currentStatus       LogisticsStatus
  shippedDate         DateTime
  lastUpdatedAt       DateTime
  transportDays       Int?
  orderId             String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  channel             LogisticsChannel @relation(fields: [channelId], references: [id])
  store               Store?           @relation(fields: [storeId], references: [id])
  events              TrackingEvent[]
}

model TrackingEvent {
  id          String            @id @default(uuid())
  trackingId  String
  timestamp   DateTime
  location    String?
  description String
  status      LogisticsStatus
  tracking    LogisticsTracking @relation(fields: [trackingId], references: [id])
}

model PurchaseContract {
  id                  String                 @id @default(uuid())
  contractNumber      String                 @unique
  supplierId          String?
  supplierName        String
  sku                 String
  skuId               String?
  unitPrice           Decimal                @db.Decimal(18, 2)
  totalQty            Int
  pickedQty           Int                    @default(0)
  finishedQty         Int                    @default(0)
  totalAmount         Decimal                @db.Decimal(18, 2)
  depositRate         Decimal                @db.Decimal(5, 2)
  depositAmount       Decimal                @db.Decimal(18, 2)
  depositPaid         Decimal                @default(0) @db.Decimal(18, 2)
  tailPeriodDays      Int
  deliveryDate        DateTime?
  status              PurchaseContractStatus
  contractVoucher     String?
  totalPaid           Decimal                @default(0) @db.Decimal(18, 2)
  totalOwed           Decimal                @default(0) @db.Decimal(18, 2)
  relatedOrderIds     String[]
  relatedOrderNumbers String[]
  approvedBy          String?
  approvedAt          DateTime?
  approvalResult      String?
  approvalNotes       String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  deliveryOrders      DeliveryOrder[]
  generatedContracts  GeneratedContract[]
  supplier            Supplier?              @relation("SupplierToContract", fields: [supplierId], references: [id])
  items               PurchaseContractItem[]
  orders              PurchaseOrder?
}

model DeliveryOrder {
  id                     String              @id @default(uuid())
  deliveryNumber         String              @unique
  contractId             String
  contractNumber         String
  qty                    Int
  /// 按合同明细 itemId 存储的本次拿货数量 { "itemId": qty }，用于列表展示真实拿货数量
  itemQtys               Json?
  domesticTrackingNumber String?
  shippedDate            DateTime?
  status                 DeliveryOrderStatus
  tailAmount             Decimal             @db.Decimal(18, 2)
  tailPaid               Decimal             @default(0) @db.Decimal(18, 2)
  tailDueDate            DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  contract               PurchaseContract    @relation(fields: [contractId], references: [id])
  inventoryLogs          InventoryLog[]
  pendingInbound         PendingInbound?
  exportTaxCases         ExportTaxCase[]
}

model ExportTaxCase {
  id                       String              @id @default(uuid())
  caseNumber               String              @unique
  deliveryOrderId          String
  deliveryNumber           String
  contractId               String
  contractNumber           String
  supplierId               String?
  supplierName             String
  exporterId               String?
  exporterName             String?
  destinationCountry       String?
  status                   String              @default("DRAFT")
  declarationCurrency      String              @default("CNY")
  declarationAmount        Decimal             @default(0) @db.Decimal(18, 2)
  customsDeclarationNumber String?
  declarationDate          DateTime?
  declarationVouchers      Json?
  invoiceStatus            String              @default("PENDING")
  invoiceCurrency          String              @default("CNY")
  invoiceAmount            Decimal             @default(0) @db.Decimal(18, 2)
  invoiceNumber            String?
  invoiceDate              DateTime?
  invoiceReceivedDate      DateTime?
  invoiceVouchers          Json?
  taxPointStatus           String              @default("PENDING")
  taxPointRate             Decimal?            @db.Decimal(8, 4)
  taxPointAmount           Decimal             @default(0) @db.Decimal(18, 2)
  taxPointPaidAmount       Decimal             @default(0) @db.Decimal(18, 2)
  taxPointPaidDate         DateTime?
  taxPointVouchers         Json?
  refundStatus             String              @default("PENDING")
  refundCurrency           String              @default("CNY")
  refundRate               Decimal?            @db.Decimal(8, 4)
  refundClaimAmount        Decimal             @default(0) @db.Decimal(18, 2)
  refundReceivedAmount     Decimal             @default(0) @db.Decimal(18, 2)
  refundApplicationDate    DateTime?
  refundReceivedDate       DateTime?
  refundVouchers           Json?
  notes                    String?
  createdBy                String              @default("系统")
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  deliveryOrder            DeliveryOrder       @relation(fields: [deliveryOrderId], references: [id])
  items                    ExportTaxCaseItem[]

  @@index([deliveryOrderId])
  @@index([contractId])
  @@index([supplierId])
  @@index([status])
  @@index([declarationDate])
  @@index([createdAt])
}

model ExportTaxCaseItem {
  id                    String        @id @default(uuid())
  caseId                String
  contractItemId        String
  sku                   String
  skuName               String?
  spec                  String?
  qty                   Int
  needsInvoice          Boolean       @default(true)
  needsTaxRefund        Boolean       @default(true)
  purchaseUnitPrice     Decimal       @default(0) @db.Decimal(18, 4)
  purchaseAmount        Decimal       @default(0) @db.Decimal(18, 2)
  declarationUnitPrice  Decimal       @default(0) @db.Decimal(18, 4)
  declarationAmount     Decimal       @default(0) @db.Decimal(18, 2)
  invoiceUnitPrice      Decimal?      @db.Decimal(18, 4)
  invoiceAmount         Decimal       @default(0) @db.Decimal(18, 2)
  taxRate               Decimal?      @db.Decimal(8, 4)
  refundRate            Decimal?      @db.Decimal(8, 4)
  estimatedRefundAmount Decimal       @default(0) @db.Decimal(18, 2)
  hsCode                String?
  customsName           String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  exportTaxCase         ExportTaxCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([contractItemId])
  @@index([sku])
}

model PendingInbound {
  id                     String               @id @default(uuid())
  inboundNumber          String               @unique
  deliveryOrderId        String?              @unique
  deliveryNumber         String?
  contractId             String?
  contractNumber         String?
  sku                    String
  variantId              String?
  qty                    Int
  receivedQty            Int                  @default(0)
  domesticTrackingNumber String?
  shippedDate            DateTime?
  status                 String               @default("待入库")
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  fromOutboundId         String?
  fromOutboundNumber     String?
  batches                InboundBatch[]
  outboundOrder          OutboundOrder?
  deliveryOrder          DeliveryOrder?       @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  variant                ProductVariant?      @relation(fields: [variantId], references: [id])
  items                  PendingInboundItem[]

  @@index([deliveryOrderId])
  @@index([fromOutboundId])
  @@index([variantId])
  @@index([status])
}

model PendingInboundItem {
  id               String          @id @default(uuid())
  pendingInboundId String
  variantId        String?
  sku              String
  skuName          String?
  spec             String?
  qty              Int
  receivedQty      Int             @default(0)
  unitPrice        Decimal?        @db.Decimal(18, 2)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  pendingInbound   PendingInbound  @relation(fields: [pendingInboundId], references: [id], onDelete: Cascade)
  variant          ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([pendingInboundId])
  @@index([variantId])
}

model InboundBatch {
  id               String         @id @default(uuid())
  pendingInboundId String
  batchNumber      String
  warehouseId      String
  warehouseName    String
  qty              Int
  receivedDate     DateTime
  notes            String?
  createdAt        DateTime       @default(now())
  pendingInbound   PendingInbound @relation(fields: [pendingInboundId], references: [id], onDelete: Cascade)
  warehouse        Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([pendingInboundId])
  @@index([warehouseId])
}

model OutboundOrder {
  id                  String               @id @default(uuid())
  outboundNumber      String               @unique
  variantId           String?
  sku                 String?
  qty                 Int?
  shippedQty          Int                  @default(0)
  warehouseId         String
  warehouseName       String
  destination         String?
  status              String               @default("待出库")
  reason              String?
  pendingInboundId    String?              @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  containerPreRecords ContainerPreRecord[]
  batches             OutboundBatch[]
  pendingInbound      PendingInbound?      @relation(fields: [pendingInboundId], references: [id])
  variant             ProductVariant?      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse           Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  items               OutboundOrderItem[]

  @@index([variantId])
  @@index([warehouseId])
}

model OutboundOrderItem {
  id                 String              @id @default(uuid())
  outboundOrderId    String
  variantId          String?
  sku                String
  skuName            String?
  spec               String?
  qty                Int
  shippedQty         Int                 @default(0)
  unitPrice          Decimal?            @db.Decimal(18, 2)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  outboundBatchItems OutboundBatchItem[]
  outboundOrder      OutboundOrder       @relation(fields: [outboundOrderId], references: [id], onDelete: Cascade)
  variant            ProductVariant?     @relation(fields: [variantId], references: [id])

  @@index([outboundOrderId])
  @@index([variantId])
}

model OutboundBatchItem {
  id                  String             @id @default(uuid())
  outboundBatchId     String
  outboundOrderItemId String?
  variantId           String?
  sku                 String
  skuName             String?
  spec                String?
  qty                 Int
  createdAt           DateTime           @default(now())
  outboundBatch       OutboundBatch      @relation(fields: [outboundBatchId], references: [id], onDelete: Cascade)
  outboundOrderItem   OutboundOrderItem? @relation(fields: [outboundOrderItemId], references: [id])
  variant             ProductVariant?    @relation(fields: [variantId], references: [id])

  @@index([outboundBatchId])
  @@index([variantId])
}

model Container {
  id                  String          @id @default(uuid())
  containerNo         String          @unique
  containerType       String
  sealNo              String?
  shippingMethod      ShippingMethod
  shipCompany         String?
  vesselName          String?
  voyageNo            String?
  originPort          String?
  destinationPort     String?
  etd                 DateTime?
  eta                 DateTime?
  actualDeparture     DateTime?
  actualArrival       DateTime?
  status              ContainerStatus @default(PLANNED)
  totalVolumeCBM      Decimal?        @db.Decimal(18, 3)
  totalWeightKG       Decimal?        @db.Decimal(18, 3)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  declaredCurrency    String?
  declaredValue       Decimal?        @db.Decimal(18, 2)
  destinationCountry  String?
  dutyAmount          Decimal?        @db.Decimal(18, 2)
  dutyCurrency        String?
  dutyPaidAmount      Decimal?        @db.Decimal(18, 2)
  dutyPayer           String?
  exportMode          String?
  exporterId          String?
  exporterName        String?
  overseasCompanyId   String?
  overseasCompanyName String?
  platform            String?
  returnAmount        Decimal?        @db.Decimal(18, 2)
  returnCurrency      String?
  returnDate          DateTime?
  serviceMode         String?
  storeId             String?
  storeName           String?
  warehouseId         String?
  warehouseName       String?
  loadingDate         DateTime?
  customsClearanceAt  DateTime?
  warehouseInboundAt  DateTime?
  outboundBatches     OutboundBatch[]
}

model OutboundBatch {
  id                   String               @id @default(uuid())
  outboundOrderId      String
  batchNumber          String
  warehouseId          String
  warehouseName        String
  qty                  Int
  shippedDate          DateTime
  destination          String?
  trackingNumber       String?
  shippingMethod       ShippingMethod?
