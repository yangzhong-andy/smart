// 应收款管理（借款/投资/预支/其他应收）
model Receivable {
  id              String    @id @default(uuid())
  receivableNo    String? // 单号 REC-YYYYMMDD-XXXX
  type            String // 借款/投资/个人预支/其他应收
  counterparty    String // 对方名称
  description     String // 描述
  originalAmount  Decimal   @db.Decimal(18, 2)
  currentBalance  Decimal   @db.Decimal(18, 2)
  currency        String // CNY/USD/HKD
  dueDate         DateTime? // 预计回收日
  issuedDate      DateTime // 放款日
  status          String    @default("Draft") // Draft/Pending_Approval/Approved/Rejected/Disbursed/PartiallyReceived/Settled
  receiptRecords  Json?     @default("[]") // 回收记录
  outFlowId       String? // 放款流水ID
  outAccountId    String? // 放款账户ID
  outAccountName  String?
  rejectionReason String?
  notes           String?
  createdBy       String    @default("系统")
  approvedBy      String?
  approvedAt      DateTime?
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([type])
  @@index([counterparty])
}

// 工资单（月度）
model Payroll {
  id        String  @id @default(uuid())
  payrollNo String? // 工资单号 SAL-202605-XXXX

  // 关联
  employeeId   String
  employeeName String
  department   String
  periodLabel  String // 月份 2026-05

  // 薪资组成
  baseSalary     Float @default(0)
  positionSalary Float @default(0)
  actualSalary   Float @default(0)
  fullAttendance Float @default(0)
  totalSalary    Float @default(0)

  // 考勤
  monthDays        Int     @default(31)
  workHourStandard Int     @default(8)
  restDays         Int     @default(7)
  legalHolidays    Int     @default(0)
  injuryHolidays   Int     @default(0)
  paidLeaveTotal   Int     @default(0)
  payableDays      Int     @default(24)
  personalLeave    String?
  sickLeave        String?
  actualAttendDays Int     @default(24)

  // 应发合计
  payableAmount Float @default(0)

  // 浮动工资
  performance    Float @default(0)
  commission     Float @default(0)
  otherAllowance Float @default(0)

  // 应扣金额
  absenteeism    Float @default(0)
  lateRecords    Json?
  missedPunch    Json?
  leaveDeduction Json?
  advancePayment Float @default(0)
  otherDeduction Float @default(0)
  totalDeduction Float @default(0)

  // 应发工资
  grossSalary Float @default(0)

  // 代扣代缴
  pension      Float @default(0)
  unemployment Float @default(0)
  medical      Float @default(0)
  incomeTax    Float @default(0)

  // 实发工资
  netSalary Float @default(0)

  // 付款信息
  bankAccount String?
  bankName    String?
  idNumber    String?
  phone       String?
  notes       String?

  // 状态与审批
  status          String    @default("Draft")
  submittedAt     DateTime?
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?

  // 财务关联
  outFlowId      String?
  outAccountId   String?
  outAccountName String?
  businessNumber String?
  paidBy         String?
  paidAt         DateTime?
  paymentVoucher String?

  createdBy String   @default("系统")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([periodLabel])
  @@index([employeeId])
  @@index([status])
  @@index([department])
}

// TikTok Shop 授权配置
model TikTokShopSetting {
  id               String    @id @default(uuid())
  shopId           String    @unique // TikTok 店铺ID
  shopName         String // 店铺名称
  region           String    @default("UNSET") // TikTok站点国家代码；无法识别时不猜测
  regionSource     String    @default("LEGACY") // TIKTOK/MANUAL/LEGACY/PENDING
  regionVerifiedAt DateTime?
  sellerType       String? // 卖家类型
  appKey           String? // 关联的 App Key
  shopCipher       String? // 店铺密钥（API调用必需）
  bankAccountId    String? // 关联的财务账户(BankAccount.id)
  storeId          String?   @unique // 关联的系统店铺
  accessToken      String? // 访问令牌
  refreshToken     String? // 刷新令牌
  tokenExpireAt    DateTime? // 令牌过期时间
  openId           String? // 开放平台用户ID
  status           String    @default("disconnected") // active/expired/disconnected
  lastSyncAt       DateTime? // 最后同步时间
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  store            Store?    @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([region])
  @@index([status])
}

// TikTok 订单数据
model TikTokOrder {
  id               String    @id @default(uuid())
  shopId           String // 店铺ID
  orderId          String    @unique // TikTok 订单ID
  status           String? // 订单状态
  orderStatus      String? // UNPAID/ON_HOLD/IN_TRANSIT/DELIVERED/COMPLETED/CANCELLED
  totalAmount      String? // 总金额
  currency         String? // 币种
  itemCount        Int? // 商品数量
  buyerEmail       String? // 买家邮箱（脱敏）
  shippingProvider String? // 物流商
  trackingNumber   String? // 物流单号
  createTime       DateTime? // 下单时间
  updateTime       DateTime? // 更新时间
  rawData          Json? // 原始数据
  syncedAt         DateTime  @default(now()) // 同步时间

  @@index([shopId])
  @@index([orderId])
  @@index([status])
  @@index([createTime])
}

