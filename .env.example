# 数据库连接（必填）
# DATABASE_URL=postgresql://USER:<PASSWORD>@HOST:5432/DATABASE
# TikTok 凭证加密密钥（建议与 NEXTAUTH_SECRET 使用不同的随机值；未设置时兼容回退到 NEXTAUTH_SECRET）
# TIKTOK_SECRET_KEY=<RANDOM_SECRET>

# 汇率 API（可选，用于财务工作台实时汇率）
# 免费申请：https://www.exchangerate-api.com/
# 申请后把 API Key 填到下面，复制本文件为 .env.local 并填写实际值
# EXCHANGERATE_API_KEY=<SET_LOCALLY>

# 本公司（甲方/需方）信息，用于采购合同等单据
# 复制到 .env.local 并填写实际值后，生成合同时会自动带入甲方信息
# COMPANY_NAME="公司全称"
# COMPANY_ADDRESS="公司地址"
# COMPANY_PHONE="联系电话"
# COMPANY_CONTACT="联系代表/签字人"
# COMPANY_BANK_ACCOUNT="付款账号卡号"
# COMPANY_BANK_ACCOUNT_NAME="付款账号户名"
# COMPANY_BANK_NAME="开户行"
# COMPANY_TAX_ID="税号（可选）"
# Overseas stock is an asset ledger. Keep this off until opening stocktake and
# BOM/warehouse-switch deduction verification have both been completed.
ENABLE_AUTOMATIC_STOCK_DEDUCTION=false
